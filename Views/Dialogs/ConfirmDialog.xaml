<Window x:Class="CryptoJournal.Wpf.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding TitleText}"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}"
        Background="#323232">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dialog Header Column -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryDark" Padding="14" CornerRadius="12">
            <DockPanel>
                <materialDesign:PackIcon Kind="AlertOutline" Width="22" Height="22" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding HeaderText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Main Message Body -->
        <materialDesign:Card Grid.Row="1" Margin="0,12,0,12" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Standard Text Message -->
                    <TextBlock Text="{Binding MessageText}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               FontSize="13"
                               Opacity="0.95">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLines}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Structured Key-Value Details -->
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLines}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold"
                                               Width="140"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Value}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <!-- Action Controls -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    Width="140"
                    Margin="8,0,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{Binding ConfirmBrush}"
                    Foreground="#111"
                    IsDefault="True"
                    Click="Ok_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConfirmText}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button DockPanel.Dock="Right"
                    Width="140"
                    IsCancel="True"
                    Click="Cancel_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CancelText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CancelText}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>