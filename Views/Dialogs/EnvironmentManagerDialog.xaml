<Window x:Class="CryptoJournal.Wpf.Views.Dialogs.EnvironmentManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ui="clr-namespace:CryptoJournal.Wpf.UI"
        Title="Environments"
        Width="980"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- Application Color Palette -->
        <SolidColorBrush x:Key="Env.Bg"        Color="#323232"/>
        <SolidColorBrush x:Key="Env.Card"      Color="#1A1A1A"/>
        <SolidColorBrush x:Key="Env.Muted"     Color="#232323"/>
        <SolidColorBrush x:Key="Env.Border"    Color="#2E2E2E"/>
        <SolidColorBrush x:Key="Env.Text"      Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Env.TextMuted" Color="#A8A8A8"/>

        <!-- Primary Accent Color -->
        <SolidColorBrush x:Key="Env.Accent" Color="#00C7D9"/>
        <!-- Transparent Accent Variations -->
        <SolidColorBrush x:Key="Env.Accent10" Color="#1A00C7D9"/>
        <SolidColorBrush x:Key="Env.Accent30" Color="#4D00C7D9"/>

        <!-- Destructive Action Color -->
        <SolidColorBrush x:Key="Env.Destructive" Color="#FF4D4D"/>

        <CornerRadius x:Key="Env.RadiusLg">14</CornerRadius>
        <CornerRadius x:Key="Env.RadiusMd">10</CornerRadius>

        <!-- Value Converters -->
        <ui:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <ui:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <ui:IdEqualsConverter x:Key="IdEqualsConverter"/>

        <Style x:Key="Env.ListBoxItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Base ListBoxItem Container Style Override -->
        <Style x:Key="Env.ListBoxItemContainer" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="True"/>

            <!-- Container Rendering Override -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Badge Icon Style -->
        <Style x:Key="Env.HeaderBadge" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource Env.Accent10}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Env.Accent30}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Icon Button Formats -->
        <Style x:Key="Env.IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Foreground" Value="{StaticResource Env.TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- Add Item Button Style -->
        <Style x:Key="Env.AddButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="BorderBrush" Value="{StaticResource Env.Accent30}"/>
            <Setter Property="Foreground" Value="{StaticResource Env.Accent}"/>
            <Setter Property="Background" Value="{StaticResource Env.Accent10}"/>
            <Setter Property="Height" Value="44"/>
        </Style>

        <!-- Submit Action Button Style -->
        <Style x:Key="Env.UpdateButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="{StaticResource Env.Accent}"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource Env.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Main -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom close -->
        </Grid.RowDefinitions>

        <!-- Main Header Section -->
        <Border Grid.Row="0"
                Background="{StaticResource Env.Card}"
                BorderBrush="{StaticResource Env.Border}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" >
                    <Border Style="{StaticResource Env.HeaderBadge}" Margin="0,0,12,0">
                        <Border Margin="8" Background="{StaticResource Env.Accent}" CornerRadius="2"/>
                    </Border>

                    <TextBlock Text="Environments"
                               Foreground="{StaticResource Env.Text}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Primary Content Grid -->
        <Border Grid.Row="1"
                Margin="18"
                Background="{StaticResource Env.Card}"
                BorderBrush="{StaticResource Env.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Env.RadiusLg}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Environment Selection List -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Env.Muted}">
                    <ListBox ItemsSource="{Binding Items}"
                        SelectedItem="{Binding Selected}"
                        ItemContainerStyle="{StaticResource Env.ListBoxItemContainer}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemRoot"
                                    CornerRadius="{StaticResource Env.RadiusMd}"
                                    Background="{StaticResource Env.Card}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Padding="14,10"
                                    MinHeight="72"
                                    Margin="0">

                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Active Selection Indicator -->
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="{x:Type Ellipse}">
                                                    <Setter Property="Fill" Value="#555555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource IdEqualsConverter}">
                                                                    <Binding Path="Id"/>
                                                                    <Binding Path="DataContext.CurrentId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Fill" Value="#34D399"/>
                                                            <!-- Active State Color -->
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Item Details -->
                                        <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                Foreground="{StaticResource Env.Text}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding QuoteCurrency}"
                                                Foreground="{StaticResource Env.TextMuted}"
                                                FontSize="11"
                                                Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Deletion Action -->
                                        <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="-4,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Env.IconButton}">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Env.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Env.Destructive}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>

                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Interaction State Triggers -->
                                <DataTemplate.Triggers>
                                    <!-- Selected State -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Env.Accent10}"/>
                                        <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Env.Accent30}"/>
                                    </DataTrigger>

                                    <!-- Hover State for Unselected Items -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="ItemRoot" Property="Background" Value="#2A2A2A"/>
                                        <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Env.Border}"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Action Footer for List -->
                <Border Grid.Row="1" Grid.Column="0"
                    Background="{StaticResource Env.Muted}"
                    BorderBrush="{StaticResource Env.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="14">
                    <Button Style="{StaticResource Env.AddButton}" Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Add Environment" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Section Divider -->
                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Background="{StaticResource Env.Border}"/>

                <!-- Details Panel -->
                <Grid Grid.Row="0" Grid.Column="2">
                    <!-- Environment Editing View -->
                    <Grid Visibility="{Binding Selected, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <StackPanel Margin="26" VerticalAlignment="Top">
                            <TextBlock Text="Details"
                                Foreground="{StaticResource Env.Text}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Margin="0,0,0,20"/>

                            <TextBlock Text="ENVIRONMENT NAME"
                                Foreground="{StaticResource Env.TextMuted}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="0,0,0,6"/>

                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                Background="#1F1F1F"
                                Foreground="{StaticResource Env.Text}"
                                BorderBrush="{StaticResource Env.Border}"
                                Margin="0,0,0,18"/>

                            <TextBlock Text="QUOTE (USDT, USDC, USD, etc.)"
                                Foreground="{StaticResource Env.TextMuted}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="0,0,0,6"/>

                            <TextBox Text="{Binding EditQuote, UpdateSourceTrigger=PropertyChanged}"
                                Background="#1F1F1F"
                                Foreground="{StaticResource Env.Text}"
                                BorderBrush="{StaticResource Env.Border}"
                                Margin="0,0,0,18"/>
                        </StackPanel>
                    </Grid>

                    <!-- Empty State View -->
                    <Grid Visibility="{Binding Selected, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="Select an environment to view details"
                            Foreground="{StaticResource Env.TextMuted}"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            FontSize="14" Margin="0,258,0,0"/>
                    </Grid>
                </Grid>

                <!-- Details Action Footer -->
                <Border Grid.Row="1" Grid.Column="2"
                    BorderBrush="{StaticResource Env.Border}"
                    BorderThickness="0,1,0,0"
                    Background="#171717"
                    Padding="20,16"
                    Visibility="{Binding Selected, Converter={StaticResource NotNullToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Env.UpdateButton}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Update" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </Grid>

        </Border>

        <!-- Dialog Closure Section -->
        <Border Grid.Row="2"
                Background="{StaticResource Env.Card}"
                BorderBrush="{StaticResource Env.Border}"
                BorderThickness="0,1,0,0"
                Padding="18,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Width="140"
                        IsCancel="True"
                        BorderBrush="{StaticResource Env.Accent30}"
                        Foreground="{StaticResource Env.Accent}"
                        Background="Transparent">
                    Close
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>