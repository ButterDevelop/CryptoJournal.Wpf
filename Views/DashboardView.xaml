<UserControl x:Class="CryptoJournal.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:ctx="clr-namespace:LiveChartsCore.Kernel;assembly=LiveChartsCore"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:ui="clr-namespace:CryptoJournal.Wpf.UI">

    <UserControl.Resources>
        <ui:FlexibleDecimalConverter x:Key="DecConv"/>
        <CollectionViewSource x:Key="ScenarioRowsView" Source="{Binding ScenarioRows}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="CurrentValue" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <ui:SmartQtyConverter x:Key="SmartQtyConv"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Key Performance Indicator Overview -->
            <UniformGrid Columns="4" Margin="0,0,0,0">
                <materialDesign:Card Padding="14" Margin="10,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Total equity (cash + positions)" Opacity="0.75"/>
                        <TextBlock Text="{Binding TotalEquity, StringFormat={}{0:C2}, TargetNullValue=—}"
                                   FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="14" Margin="0,0,16,12">
                    <StackPanel>
                        <TextBlock Text="Positions value" Opacity="0.75"/>
                        <TextBlock Text="{Binding PositionsValue, StringFormat={}{0:C2}, TargetNullValue=—}"
                                   FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="14" Margin="16,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Free funds (quote cash)" Opacity="0.75"/>
                        <TextBlock Text="{Binding CashQuote, StringFormat={}{0:C2}}"
                                   FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="14" Margin="0,0,10,12">
                    <StackPanel>
                        <TextBlock Text="Equity @ Scenarios" Opacity="0.75"/>
                        <TextBlock Text="{Binding EquityAtScenarios, StringFormat={}{0:C2}, TargetNullValue=—}"
                                   FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Analytical Visualizations -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Allocation" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <lvc:PieChart Series="{Binding AllocationSeries}" Height="260"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="PnL (Realized vs Unrealized)" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <lvc:CartesianChart Grid.Row="1"
                            Series="{Binding PnlSeries}"
                            XAxes="{Binding PnlXAxes}"
                            YAxes="{Binding PnlYAxes}"
                            LegendPosition="Hidden"
                            TooltipPosition="Top"
                            Height="120"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"/>

                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Active Scenarios Summary -->
            <materialDesign:Card Padding="14">
                <StackPanel>
                    <TextBlock Text="Scenarios overview" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Source={StaticResource ScenarioRowsView}}" AutoGenerateColumns="False" IsReadOnly="True"
                              ColumnWidth="*"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Symbol" SortMemberPath="Symbol" Width="SizeToCells" MinWidth="140">

                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment"   Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Image Width="16" Height="16"
                                                   Margin="0,0,8,0"
                                                   Source="{Binding SymbolIcon}"
                                                   SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Symbol}" VerticalAlignment="Center"/>
                                            <Border CornerRadius="4" 
                                                    Padding="4,2" 
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1A66B2FF"/> <!-- Light blue background for Long positions -->
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SideLabel}" Value="SHORT">
                                                                <Setter Property="Background" Value="#1AFF9966"/> <!-- Orange background for Short positions -->
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFutures}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SideLabel}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#66B2FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SideLabel}" Value="SHORT">
                                                                    <Setter Property="Foreground" Value="#FF9966"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Qty" SortMemberPath="Qty">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center"
                                                   ui:SmartQtyAssist.EnableToggle="True"
                                                   ToolTip="{Binding Qty}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource SmartQtyConv}">
                                                    <Binding Path="Qty"/>
                                                    <Binding Path="(ui:SmartQtyAssist.IsExpanded)" RelativeSource="{RelativeSource Self}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mark"              Binding="{Binding Mark,                         StringFormat={}{0:C2}}"/>
                            <DataGridTextColumn Header="ATH"               Binding="{Binding Ath,                          StringFormat={}{0:C2}, TargetNullValue=—}"/>
                            <DataGridTextColumn Header="Current Value"     Binding="{Binding CurrentValue,                 StringFormat={}{0:C2}}"
                                                SortMemberPath="CurrentValue" SortDirection="Descending"/>
                            <DataGridTextColumn Header="Scenario Qty Left" Binding="{Binding RemainingQty,                 Converter={StaticResource DecConv}}"/>
                            <DataGridTextColumn Header="Equity @ Scenario" Binding="{Binding EquityContributionAtScenario, StringFormat={}{0:C2}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>