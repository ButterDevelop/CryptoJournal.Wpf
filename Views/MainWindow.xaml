<Window x:Class="CryptoJournal.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CryptoJournal.Wpf.Views"
        xmlns:vm="clr-namespace:CryptoJournal.Wpf.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        Height="820" Width="1300" MinHeight="700" MinWidth="1000"
        Style="{StaticResource MaterialDesignWindow}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>

        <!-- Primary Content Area -->
        <Grid x:Name="ContentHost">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="12"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <TabControl>
                <TabItem Header="Dashboard">
                    <views:DashboardView DataContext="{Binding DashboardVm}"/>
                </TabItem>

                <TabItem Header="Transactions">
                    <views:TransactionsView DataContext="{Binding TransactionsVm}"/>
                </TabItem>

                <TabItem Header="Positions">
                    <views:PositionsView DataContext="{Binding PositionsVm}"/>
                </TabItem>

                <TabItem Header="Futures">
                    <views:FuturesView DataContext="{Binding FuturesVm}"/>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline"
                                         Width="18" Height="18"
                                         Margin="0,0,6,0"/>
                            <TextBlock Text="Info"/>
                        </StackPanel>
                    </TabItem.Header>

                    <views:AboutView DataContext="{Binding AboutVm}"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Application Loading State Overlay -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Background="#AA000000"
                Panel.ZIndex="999">

            <materialDesign:Card Padding="26"
                                 Background="#CC1A1A1A"
                                 UniformCornerRadius="16"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Loading :)"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.35" To="1.0"
                                                         Duration="0:0:0.70"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <TextBlock Text="Preparing data..."
                               Foreground="#A8A8A8"
                               Margin="0,8,0,14"
                               HorizontalAlignment="Center"/>

                    <!-- Generic indeterminate progress indicator pending specific styling -->
                    <ProgressBar Width="260"
                                 Height="6"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </materialDesign:Card>
        </Border>

    </Grid>
</Window>